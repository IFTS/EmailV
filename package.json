{
  "name": "ifts-emailv-enterprise",
  "version": "3.0.0",
  "description": "Enterprise multi-tenant SaaS email marketing platform",
  "private": true,
  "scripts": {
    "backend": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-seed",
    "db:migrate-dev": "prisma migrate dev",
    "db:migrate-deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:status": "prisma migrate status",
    "db:rollback": "prisma migrate rollback",
    "docker": "docker compose up -d",
    "docker:build": "docker compose build",
    "docker:stop": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "backup": "./scripts/backup.sh --backup",
    "backup:list": "./scripts/backup.sh --list",
    "password:audit": "tsx scripts/migrate-passwords.ts audit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bullmq": "^4.18.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^8.0.7",
    "openai": "^4.77.0",
    "resend": "^3.0.0",
    "uuid": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
