# Database
DATABASE_URL=postgresql://user:password@localhost:5432/emailv

# Redis
REDIS_URL=redis://localhost:6379

# Email
RESEND_API_KEY=re_your_resend_key
SMTP_PASSWORD=your_smtp_password

# AI
OPENAI_API_KEY=sk_your_openai_key

# External Validation APIs (optional)
ZEROBOUNCE_API_KEY=your_zerobounce_key
NEVERBOUNCE_API_KEY=your_neverbounce_key
KICKBOX_API_KEY=your_kickbox_key

# Security
MASTER_ENCRYPTION_KEY=your_32_character_master_key!

# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# Rate Limits
EMAIL_CONCURRENCY=5
EMAIL_RATE_LIMIT=10
EMAIL_MAX_RETRIES=3
